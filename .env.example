# AdaptiveLearn AI Configuration

# Secret Key for Flask Sessions
SECRET_KEY=adaptivelearn-ai-secret-key-2026-production-ready

# Database Settings (MySQL)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adaptivelearn_db

# External APIs (Optional - Demo mode works seamlessly without these)
